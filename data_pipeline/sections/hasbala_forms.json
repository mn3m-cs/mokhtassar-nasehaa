    },
    {
      "id": 1915,
      "body": "١- ﴿ حَسۡبُنَا ٱللَّهُ وَنِعۡمَ ٱلۡوَكِيلُ ﴾",
      "count": 1,
      "hokm": "",
      "source": "صيغ الحسبلة. [آل عمران: ١٧٣]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1916,
      "body": "٢- ﴿ حَسۡبِيَ ٱللَّهُۖ عَلَيۡهِ يَتَوَكَّلُ ٱلۡمُتَوَكِّلُونَ ﴾",
      "count": 1,
      "hokm": "",
      "source": "صيغ الحسبلة. [الزمر: ٣٨]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1917,
      "body": "٣- ﴿ حَسۡبِيَ ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ عَلَيۡهِ تَوَكَّلۡتُۖ وَهُوَ رَبُّ ٱلۡعَرۡشِ ٱلۡعَظِيمِ ﴾",
      "count": 1,
      "hokm": "",
      "source": "صيغ الحسبلة. [التوبة: ١٢٩]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1918,
      "body": "٤- حسبي الله ونعم الوكيل.",
      "count": 1,
      "hokm": "",
      "source": "صيغ الحسبلة. (ص357)",
      "fadl": ""
    },
    {
      "id": 1919,
      "body": "ويقرب من هذه الصيغ:",
      "count": 0,
      "hokm": "",
      "source": "صيغ الحسبلة. (ص357)",
      "fadl": ""
    },
    {
      "id": 1920,
      "body": "٥- ﴿ هُوَ رَبِّي لَآ إِلَٰهَ إِلَّا هُوَ عَلَيۡهِ تَوَكَّلۡتُ وَإِلَيۡهِ مَتَابِ ﴾",
      "count": 1,
      "hokm": "",
      "source": "ويقرب من هذه الصيغ. [الرعد: ٣٠]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1921,
      "body": "٦- ﴿ وَمَا تَوۡفِيقِيٓ إِلَّا بِٱللَّهِۚ عَلَيۡهِ تَوَكَّلۡتُ وَإِلَيۡهِ أُنِيبُ ﴾",
      "count": 1,
      "hokm": "",
      "source": "ويقرب من هذه الصيغ. [هود: ٨٨]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1922,
      "body": "٧- ﴿ رَّبَّنَا عَلَيۡكَ تَوَكَّلۡنَا وَإِلَيۡكَ أَنَبۡنَا وَإِلَيۡكَ ٱلۡمَصِيرُ ﴾",
      "count": 1,
      "hokm": "",
      "source": "ويقرب من هذه الصيغ. [الممتحنة: ٤]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1923,
      "body": "٨- ﴿ وَأُفَوِّضُ أَمۡرِيٓ إِلَى ٱللَّهِۚ إِنَّ ٱللَّهَ بَصِيرُۢ بِٱلۡعِبَادِ ﴾",
      "count": 1,
      "hokm": "",
      "source": "ويقرب من هذه الصيغ. [غافر: ٤٤]. (ص357)",
      "fadl": ""
    }
  ]
