  "items": [
    {
      "id": 1576,
      "body": "صيغ الحسبلة:",
      "count": 0,
      "hokm": "",
      "source": "(ص357)",
      "fadl": ""
    },
    {
      "id": 1577,
      "body": "﴿ حَسۡبُنَا ٱللَّهُ وَنِعۡمَ ٱلۡوَكِيلُ ﴾",
      "count": 1,
      "hokm": "",
      "source": "صيغ الحسبلة. [آل عمران: ١٧٣]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1578,
      "body": "﴿ حَسۡبِيَ ٱللَّهُۖ عَلَيۡهِ يَتَوَكَّلُ ٱلۡمُتَوَكِّلُونَ ﴾",
      "count": 1,
      "hokm": "",
      "source": "صيغ الحسبلة. [الزمر: ٣٨]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1579,
      "body": "﴿ حَسۡبِيَ ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ عَلَيۡهِ تَوَكَّلۡتُۖ وَهُوَ رَبُّ ٱلۡعَرۡشِ ٱلۡعَظِيمِ ﴾",
      "count": 1,
      "hokm": "",
      "source": "صيغ الحسبلة. [التوبة: ١٢٩]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1580,
      "body": "حسبي الله ونعم الوكيل.",
      "count": 1,
      "hokm": "",
      "source": "صيغ الحسبلة. (ص357)",
      "fadl": ""
    },
    {
      "id": 1581,
      "body": "ويقرب من هذه الصيغ:",
      "count": 0,
      "hokm": "",
      "source": "صيغ الحسبلة. (ص357)",
      "fadl": ""
    },
    {
      "id": 1582,
      "body": "﴿ هُوَ رَبِّي لَآ إِلَٰهَ إِلَّا هُوَ عَلَيۡهِ تَوَكَّلۡتُ وَإِلَيۡهِ مَتَابِ ﴾",
      "count": 1,
      "hokm": "",
      "source": "ويقرب من هذه الصيغ. [الرعد: ٣٠]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1583,
      "body": "﴿ وَمَا تَوۡفِيقِيٓ إِلَّا بِٱللَّهِۚ عَلَيۡهِ تَوَكَّلۡتُ وَإِلَيۡهِ أُنِيبُ ﴾",
      "count": 1,
      "hokm": "",
      "source": "ويقرب من هذه الصيغ. [هود: ٨٨]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1584,
      "body": "﴿ رَّبَّنَا عَلَيۡكَ تَوَكَّلۡنَا وَإِلَيۡكَ أَنَبۡنَا وَإِلَيۡكَ ٱلۡمَصِيرُ ﴾",
      "count": 1,
      "hokm": "",
      "source": "ويقرب من هذه الصيغ. [الممتحنة: ٤]. (ص357)",
      "fadl": ""
    },
    {
      "id": 1585,
      "body": "﴿ وَأُفَوِّضُ أَمۡرِيٓ إِلَى ٱللَّهِۚ إِنَّ ٱللَّهَ بَصِيرُۢ بِٱلۡعِبَادِ ﴾",
      "count": 1,
      "hokm": "",
      "source": "ويقرب من هذه الصيغ. [غافر: ٤٤]. (ص357)",
      "fadl": ""
    }
  ]
}
