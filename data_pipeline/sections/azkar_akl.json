{
  "title": {
    "name": "أذكار الأكل والشرب",
    "freq": "d",
    "order": 21,
    "nodeType": "content"
  },
  "items": [
    {
      "body": "بسمِ اللهِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "بسمِ اللهِ أوَّلَهُ وآخِرَهُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "إذا أكلَ الأكلةَ أو شربَ الشربةَ حمِدَ اللهَ عزَّ وجلَّ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ بارِكْ لنا فيهِ، وزِدْنا مِنهُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ الذي أطعَمَني هذا، ورزَقَنيهِ من غيرِ حولٍ مِنِّي ولا قوةٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": "غُفِر له ما تقدم من ذنبه"
    },
    {
      "body": "الحمدُ للهِ كثيرًا طيِّبًا مبارَكًا فيهِ، غيرَ مَكفِيٍّ، ولا مُوَدَّعٍ، ولا مُستَغنىً عنهُ رَبُّنا",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ الذي أطعَمَ وسَقَى، وسَوَّغَهُ، وجعلَ لهُ مخرَجًا",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ أطعَمتَ وسَقَيتَ، وأغنَيتَ وأقنَيتَ، وهَدَيتَ وأحييتَ، فلَكَ الحمدُ على ما أعطيتَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ بارِكْ لنا فيهِ، وأطعِمْنا خيرًا مِنهُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ الذي كفانا وأروانا، غيرَ مَكفِيٍّ، ولا مَكفورٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ بارِكْ لهم فيما رزَقتَهُم، واغفِرْ لهم وارحَمْهُم",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "أفطَرَ عندَكُمُ الصائمونَ، وأكلَ طعامَكُمُ الأبرارُ، وصلَّتْ عليكمُ الملائكةُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ أطعِمْ مَنْ أطعَمَني، واسْقِ مَنْ سَقاني",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ إنِّي أسألُكَ من فضلِكَ ورحمتِكَ، فإنَّهُ لا يملِكُها إلا أنتَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الأكل والشرب. (ص141–143)",
      "fadl": ""
    }
  ]
}
