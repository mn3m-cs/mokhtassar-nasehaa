  "items": [
    {
      "body": "يقول في أول طعامه:",
      "count": 0,
      "hokm": "",
      "source": "أذكار الأكل والشرب. (ص214)",
      "fadl": ""
    },
    {
      "body": "باسم الله",
      "count": 1,
      "hokm": "",
      "source": "أذكار الأكل والشرب. (ص214)",
      "fadl": ""
    },
    {
      "body": "وإذا نسي التسمية في أَوَّلِ الأكل، ثم ذَكَرَ، فليقل:",
      "count": 0,
      "hokm": "",
      "source": "أذكار الأكل والشرب. (ص214)",
      "fadl": ""
    },
    {
      "body": "باسم الله أَوَّلَهُ وآخِرَه",
      "count": 1,
      "hokm": "",
      "source": "أذكار الأكل والشرب. (ص214)",
      "fadl": ""
    },
    {
      "body": "وإذا أكل الأَكْلَةَ، أو شرب الشربةَ حَمِدَ اللهَ عَزَّ وَجَلَّ.",
      "count": 0,
      "hokm": "",
      "source": "أذكار الأكل والشرب. (ص214)",
      "fadl": ""
    },
    {
      "body": "وإذا شَرِبَ لَبَنًا، قال:",
      "count": 0,
      "hokm": "",
      "source": "أذكار الأكل والشرب. (ص214)",
      "fadl": ""
    },
    {
      "body": "اللهم باركْ لنا فيه، وزِدْنا منه",
      "count": 1,
      "hokm": "",
      "source": "أذكار الأكل والشرب. (ص214)",
      "fadl": ""
    }
  ]
}
