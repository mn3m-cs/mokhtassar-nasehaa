      "body": "من صيغ التكبير:",
      "count": 0,
      "hokm": "",
      "source": "(ص338)\n\nحاشية: تقدَّمت (ص١٢٣).",
      "fadl": ""
    },
    {
      "id": 1688,
      "body": "الله أكبر.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    },
    {
      "id": 1689,
      "body": "الله أكبر، الله أكبر، الله أكبر، ذو الملكوتِ والجبروتِ والكبرياءِ والعظمة.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    },
    {
      "id": 1690,
      "body": "الله أكبر، الله أكبر، الله أكبر كبيرًا.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    },
    {
      "id": 1691,
      "body": "الله أكبر، الله أكبر، الله أكبر، ولله الحمد، الله أكبر وأجلُّ، الله أكبر على ما هدانا.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    },
    {
      "id": 1692,
      "body": "الله أكبر، الله أكبر، الله أكبر، لا إله إلا الله، والله أكبر، الله أكبر، الله أكبر، ولله الحمد.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    },
    {
      "id": 1693,
      "body": "الله أكبرُ كبيرًا، الله أكبرُ كبيرًا، الله أكبر وأجل، الله أكبر، ولله الحمد.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    }
  ]
