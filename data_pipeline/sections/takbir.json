      "fadl": ""
    },
    {
      "id": 1861,
      "body": "٢- الله أكبر، الله أكبر، الله أكبر، ذو الملكوتِ والجبروتِ والكبرياءِ والعظمة.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    },
    {
      "id": 1862,
      "body": "٣- الله أكبر، الله أكبر، الله أكبر كبيرًا.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    },
    {
      "id": 1863,
      "body": "٤- الله أكبر، الله أكبر، الله أكبر، ولله الحمد، الله أكبر وأجلُّ، الله أكبر على ما هدانا.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    },
    {
      "id": 1864,
      "body": "٥- الله أكبر، الله أكبر، الله أكبر، لا إله إلا الله، والله أكبر، الله أكبر، الله أكبر، ولله الحمد.",
      "count": 1,
      "hokm": "",
      "source": "من صيغ التكبير. (ص338)",
      "fadl": ""
    },
    {
      "id": 1865,
      "body": "٦- الله أكبرُ كبيرًا، الله أكبرُ كبيرًا، الله أكبر وأجل، الله أكبر، ولله الحمد.",
