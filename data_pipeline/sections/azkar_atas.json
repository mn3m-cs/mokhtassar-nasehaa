      "hokm": "صحيح",
      "source": "أذكار العطاس. (ص144–145)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ على كلِّ حالٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار العطاس. (ص144–145)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ ربِّ العالمين",
      "count": 1,
