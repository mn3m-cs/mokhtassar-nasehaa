      "source": "أذكار العطاس. (ص144–145)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار العطاس. (ص144–145)",
      "fadl": ""
    },
    {
      "body": "يَرحَمُكَ اللهُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار العطاس. (ص144–145)",
      "fadl": ""
    },
    {
      "body": "يهديكُمُ اللهُ، ويُصلِحُ بالَكُم",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار العطاس. (ص144–145)",
      "fadl": ""
    },
    {
      "body": "يَغفِرُ اللهُ لنا ولكُم",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار العطاس. (ص144–145)",
      "fadl": ""
    },
    {
      "body": "يرحَمُنا اللهُ وإيَّاكم، ويغفرُ لنا ولكُم",
      "count": 1,
      "hokm": "أثر",
      "source": "أذكار العطاس. (ص144–145)",
      "fadl": ""
    },
    {
      "body": "إذا تثاءبَ وضعَ يدَهُ على فيهِ، ولا يقلْ: ها",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار العطاس. (ص144–145)",
      "fadl": ""
