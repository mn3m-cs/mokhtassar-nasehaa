  "items": [
    {
      "id": 1306,
      "body": "إذا عَطَسَ وضع يدَه أو ثوبَه على فِيهِ، وَخَفَضَ بها صوتَه، وقال:",
      "count": 0,
      "hokm": "",
      "source": "أذكار العطاس. (ص217)",
      "fadl": ""
    },
    {
      "id": 381,
      "body": "الحمدُ للهِ حمدًا كثيرًا طيبًا مباركًا حتى يرضى رَبُّنا، وبعدَ ما يَرْضَى من أمرِ الدنيا والآخرة",
      "count": 1,
      "hokm": "",
      "source": "أذكار العطاس. (ص217)",
      "fadl": ""
    },
    {
      "id": 382,
      "body": "أو: الحمدُ للهِ على كُلِّ حالٍ",
      "count": 1,
      "hokm": "",
      "source": "أذكار العطاس. (ص217)",
      "fadl": ""
    },
    {
      "id": 383,
      "body": "أو: الحمدُ للهِ رَبِّ العالمين",
      "count": 1,
      "hokm": "",
      "source": "أذكار العطاس. (ص217)",
      "fadl": ""
    },
    {
      "id": 384,
      "body": "أو: الحمدُ للهِ",
      "count": 1,
      "hokm": "",
      "source": "أذكار العطاس. (ص217)\n\nحاشية: قال الحافظ في «الفتح»: «والذي يتحرر من الأدلة أن كل ذلك مجزئ، لكن ما كان أكثر ثناءً أفضل، بشرط أن يكون مأثورًا».اهـ. (١٠/ ٦٠١).",
      "fadl": ""
    },
    {
      "id": 1307,
      "body": "وليقل له جليسُه:",
      "count": 0,
      "hokm": "",
      "source": "أذكار العطاس. (ص217)\n\nحاشية: إذا سمعه يحمد الله، طالما عطس، إلى ثلاث مرَّاتٍ، فإذا زاد فلا يُشَمِّتْهُ، إنما هي نزلة أو زكام.",
      "fadl": ""
    },
    {
      "id": 385,
      "body": "يَرْحَمُكَ اللهُ",
      "count": 1,
      "hokm": "",
      "source": "أذكار العطاس. (ص217)",
      "fadl": ""
    },
    {
      "id": 1308,
      "body": "ثُمَّ ليردَّ العاطِسُ قائلًا:",
      "count": 0,
      "hokm": "",
      "source": "أذكار العطاس. (ص218)",
      "fadl": ""
    },
    {
      "id": 386,
      "body": "يهديكم اللهُ، ويُصْلِحُ بالَكُم",
      "count": 1,
      "hokm": "",
      "source": "أذكار العطاس. (ص218)\n\nحاشية: «بالكم» البال: الحال، والبال: القلب. «جامع الأصول» (٤/ ٣٢٦).",
      "fadl": ""
    },
    {
      "id": 387,
      "body": "أو: يَغْفِرُ اللهُ لنا ولكم",
      "count": 1,
      "hokm": "",
      "source": "أذكار العطاس. (ص218)",
      "fadl": ""
    },
    {
      "id": 1309,
      "body": "وكان ابنُ عمر رضي الله عنهما إذا عطس، فقيل له: «يرحمك الله»؛ قال:",
      "count": 0,
      "hokm": "",
      "source": "أذكار العطاس. (ص218)",
      "fadl": ""
    },
    {
      "id": 878,
      "body": "يرحمنا الله وإيَّاكم، ويَغْفِرُ لنا ولكم",
      "count": 1,
      "hokm": "",
      "source": "أذكار العطاس. (ص218)",
      "fadl": ""
    },
    {
      "id": 1310,
      "body": "وإذا عَطَسَ غيرُ المسلم، وحَمِدَ اللهَ، قال له:",
      "count": 0,
      "hokm": "",
      "source": "أذكار العطاس. (ص218)",
      "fadl": ""
    },
    {
      "id": 1265,
      "body": "يَهْدِيكُمُ اللهُ، ويُصْلِحُ بالَكُم",
      "count": 1,
      "hokm": "",
      "source": "أذكار العطاس. (ص218)",
      "fadl": ""
    },
    {
      "id": 879,
      "body": "وإذا تثاءَبَ وضعَ يدَه على فِيهِ، ولا يقل: «ها».",
      "count": 0,
      "hokm": "",
      "source": "أذكار العطاس. (ص218)",
      "fadl": ""
