  "items": [
    {
      "id": 1644,
      "body": "إذا رأى في منامه ما يحب:",
      "count": 0,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص135)",
      "fadl": ""
    },
    {
      "id": 969,
      "body": "يحمدُ اللهَ عليه، ولا يُحَدِّثْ به إلَّا مَنْ يُحِبُّ.",
      "count": 0,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص135)",
      "fadl": ""
    },
    {
      "id": 1645,
      "body": "وإذا رأى ما يكره",
      "count": 0,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص135)",
      "fadl": ""
    },
    {
      "id": 970,
      "body": "١- فَلْيَسْتَعِذْ باللهِ من شَرِّه.",
      "count": 0,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص135)",
      "fadl": ""
    },
    {
      "id": 971,
      "body": "٢- وَيَنفُثُ عن يَسارِه. [ثلاثًا]",
      "count": 3,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص136)\n\nحاشية: النفث: نفخٌ لطيفٌ لا ريق معه، وفي رواية: «فليبصق»، وفي رواية: «فليتفل».",
      "fadl": ""
    },
    {
      "id": 972,
      "body": "٣- ويتعوَّذ باللهِ مِنَ الشيطانِ الرَّجيم. [ثلاثًا]",
      "count": 3,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص136)",
      "fadl": ""
    },
    {
      "id": 973,
      "body": "٤- ويتحوَّل عن جَنبِهِ الذي كان عليه.",
      "count": 0,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص136)",
      "fadl": ""
    },
    {
      "id": 1646,
      "body": "٥- ولا يُحَدِّث بها أحدًا.",
      "count": 0,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص136)",
      "fadl": ""
    },
    {
      "id": 1647,
      "body": "٦- ولْيَقُمْ فَلْيُصَلِّ إن أمكنه؛ فإنَّ ذلكَ أتمُّ وأكمَلُ.",
      "count": 0,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص136)",
      "fadl": ""
    },
    {
      "id": 1648,
      "body": "وإن كان يُفَزَّعُ في منامه؛ قال إذا أوى إلى فراشه:",
      "count": 0,
      "hokm": "",
      "source": "من آداب الرؤيا. (ص136)",
      "fadl": ""
    },
    {
      "id": 212,
      "body": "١- أعوذُ بكلماتِ اللهِ التَّامَّةِ، مِن غَضَبِهِ وعِقابِهِ، ومِنْ شَرِّ عِبادِهِ، ومِن هَمَزاتِ الشَّياطين، وأن يَحْضُرُونِ",
      "count": 1,
      "hokm": "",
      "source": "من آداب الرؤيا. [«الصحيحة» (٢٦٤)]. (ص136)",
      "fadl": ""
    },
    {
      "id": 213,
      "body": "٢- أعوذُ بكلماتِ اللهِ التَّامَّاتِ التي لا يُجاوِزُهُنَّ بَرٌّ ولا فاجِرٌ، مِنْ شَرِّ ما يَنْزِلُ من السماءِ، وما يَعْرُجُ فيها، ومن شَرِّ فِتَنِ الليلِ والنَّهارِ، ومِنْ كُلِّ طارقٍ، إلا طارقًا يَطْرُقُ بخيرٍ، يا رحمن",
      "count": 1,
      "hokm": "",
      "source": "من آداب الرؤيا. [«الصحيحة» (٢٧٣٨)]. (ص136)",
      "fadl": ""
    }
  ]
}
