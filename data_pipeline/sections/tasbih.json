    {
      "body": "سُبْحَانَ الْمَلِكِ الْقُدُّوسِ",
      "count": 3,
      "hokm": "أثر",
      "source": "التسبيح والتحميد والتكبير والتهليل والحوقلة. (ص190–194)",
      "fadl": ""
    },
    {
      "body": "سُبْحَانَ ذِي الْجَبَرُوتِ وَالْمَلَكُوتِ وَالْكِبْرِيَاءِ وَالْعَظَمَةِ",
      "count": 1,
      "hokm": "حسن",
      "source": "التسبيح والتحميد والتكبير والتهليل والحوقلة. (ص190–194)",
      "fadl": ""
    },
    {
      "body": "سُبْحَانَ اللهِ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللهِ، سُبْحَانَ اللهِ وَبِحَمْدِهِ",
      "count": 1,
      "hokm": "أثر",
      "source": "التسبيح والتحميد والتكبير والتهليل والحوقلة. (ص190–194)",
      "fadl": ""
    },
    {
      "body": "سُبْحَانَكَ اللهُمَّ رَبَّنَا وَبِحَمْدِكَ، اللهُمَّ اغْفِرْ لِي",
      "count": 1,
      "hokm": "صحيح",
      "source": "التسبيح والتحميد والتكبير والتهليل والحوقلة. (ص190–194)",
      "fadl": ""
    },
    {
      "body": "اللهُ أَكْبَرُ كَبِيرًا، وَالحَمْدُ لِلَّهِ كَثِيرًا، وَسُبْحَانَ اللهِ بُكْرَةً وَأَصِيلًا",
      "count": 1,
      "hokm": "صحيح",
      "source": "التسبيح والتحميد والتكبير والتهليل والحوقلة. (ص190–194)",
