  "items": [
    {
      "id": 1227,
      "body": "يوم عرفة من السَّنة، ورمضان من الشهور، ويوم الجمعة من الأسبوع في آخر ساعة بعد العصر إذا جلس ينتظر صلاةَ المغرب.",
      "count": 0,
      "hokm": "",
      "source": "أوقات إجابة الدعاء. (ص379)",
      "fadl": ""
    },
    {
      "id": 1228,
      "body": "يوم الأربعاء بين صلاتَيِ الظهر والعصر.",
      "count": 0,
      "hokm": "",
      "source": "أوقات إجابة الدعاء. (ص379)",
      "fadl": ""
    },
    {
      "id": 1229,
      "body": "جوف الليل الآخِر، ونصفه الثاني، وثلثه الأول، وثلثه الأخير، ووقت السَّحَر.",
      "count": 0,
      "hokm": "",
      "source": "أوقات إجابة الدعاء. (ص379)",
      "fadl": ""
    },
    {
      "id": 1230,
      "body": "ساعة من كل ليلة.",
      "count": 0,
      "hokm": "",
      "source": "أوقات إجابة الدعاء. (ص379)",
      "fadl": ""
    },
    {
      "id": 1231,
      "body": "ليلة القدر.",
      "count": 0,
      "hokm": "",
      "source": "أوقات إجابة الدعاء. (ص379)",
      "fadl": ""
    },
    {
      "id": 1232,
      "body": "عند الأذان، وبين الأذان والإقامة، وعند إقامة الصلاة.",
      "count": 0,
      "hokm": "",
      "source": "أوقات إجابة الدعاء. (ص379)",
      "fadl": ""
    },
    {
      "id": 1233,
      "body": "عند قراءة الدعاء الذي في الفاتحة في الصلاة: ﴿ ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ ﴾ إلى آخِرِ السُّورةِ، واستحضار ما فيها من المعاني.",
      "count": 0,
      "hokm": "",
      "source": "أوقات إجابة الدعاء. (ص379)",
      "fadl": ""
    },
    {
      "id": 1234,
      "body": "عند التأمين في الصلاة.",
