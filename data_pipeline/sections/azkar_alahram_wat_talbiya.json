  "items": [
    {
      "body": "اللهمَّ بِعُمْرَةٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الإحرام والتلبية. (ص114–116)",
      "fadl": ""
    },
    {
      "body": "لَبَّيْكَ اللهمَّ بحَجَّةٍ وعُمْرَةٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "للقارن الذي ساق الهدي. (ص114)",
      "fadl": ""
    },
    {
      "body": "لَبَّيْكَ اللهمَّ بحَجَّةٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "للمفرد بالحج. (ص114)",
      "fadl": ""
    },
    {
      "body": "لَبَّيْكَ اللهمَّ لَبَّيْكَ، ومَحِلِّي من الأرضِ حيثُ تحبِسُني",
      "count": 1,
      "hokm": "صحيح",
      "source": "الاشتراط عند الخوف من العارض. (ص114)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ هذه حَجَّةٌ لا رياءَ فيها ولا سُمْعَةَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "ما يقول بعد الإحرام بالحج. (ص115)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ هذه عُمْرَةٌ لا رياءَ فيها ولا سُمْعَةَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "ما يقول بعد الإحرام بالعمرة. (ص115)",
      "fadl": ""
    },
    {
      "body": "لَبَّيْكَ اللهمَّ لَبَّيْكَ، لَبَّيْكَ لا شريكَ لكَ لَبَّيْكَ، إنَّ الحمدَ والنعمةَ لكَ، والملكَ، لا شريكَ لكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الإحرام والتلبية. (ص114–116)",
      "fadl": ""
    },
    {
      "body": "لَبَّيْكَ إلهَ الحقِّ لَبَّيْكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الإحرام والتلبية. (ص114–116)",
      "fadl": ""
    },
    {
      "body": "لَبَّيْكَ ذا المعارِجِ لَبَّيْكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الإحرام والتلبية. (ص114–116)",
      "fadl": ""
    },
    {
      "body": "لَبَّيْكَ ذا الفواضِلِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "زيادة جائزة في التلبية. (ص115)",
      "fadl": ""
    },
    {
      "body": "لَبَّيْكَ اللهمَّ لَبَّيْكَ، لَبَّيْكَ وَسَعْدَيْكَ، والخيرُ في يديكَ لَبَّيْكَ، والرَّغْباءُ إليكَ والعملُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الإحرام والتلبية. (ص114–116)",
      "fadl": ""
    }
