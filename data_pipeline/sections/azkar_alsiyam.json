  },
  "items": [
    {
      "body": "اللهُ أكبرُ، اللهمَّ أَهِلَّهُ علينا بالأمنِ والإيمانِ، والسلامَةِ والإسلامِ، والتوفيقِ لمَا تُحِبُّ وتَرضَى، ربُّنا وربُّكَ الله",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الصيام. (ص112–113)",
      "fadl": ""
    },
    {
      "body": "أعوذُ باللهِ من شرِّ هذا الغاسِقِ إذا وَقَبَ",
      "count": 1,
      "hokm": "قرآني",
      "source": "أذكار الصيام. (ص112–113)",
      "fadl": ""
    },
    {
      "body": "إنِّي صائمٌ، إنِّي صائمٌ",
      "count": 2,
      "hokm": "صحيح",
      "source": "أذكار الصيام. (ص112–113)",
      "fadl": ""
    },
    {
      "body": "ذهبَ الظمأُ، وابْتَلَّتِ العروقُ، وثبتَ الأجرُ إن شاءَ اللهُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الصيام. (ص112–113)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ لكَ صُمتُ، وعلى رِزقِكَ أفطرتُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "ما يقول بعد الإفطار. (ص113)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ إنَّكَ عَفُوٌّ تُحِبُّ العفوَ، فاعفُ عَنِّي",
      "count": 1,
      "hokm": "صحيح",
      "source": "أذكار الصيام. (ص112–113)",
      "fadl": ""
    }
  ]
}
