{
  "title": {
    "name": "الأذكار المتفرقة من السنة",
    "freq": "d"
  },
  "items": [
    {
      "body": "أحبَّكَ الذي أحبَبتَني لهُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "وأنا واللهِ أُحِبُّكَ في اللهِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أضحَكَ اللهُ سِنَّكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "بارَكَ اللهُ لكَ في أهلِكَ ومالِكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "ولَكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "لَبَّيكَ، أو: لَبَّيكَ وسَعدَيكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أمسِكْ، لا تُسمِعْهُ فتُهلِكَهُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "ويحَكَ! قَطعتَ عُنُقَ صاحبِكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أحسَبُهُ كذا، واللهُ حَسيبُهُ، ولا أُزَكِّي على اللهِ أحدًا",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ لا تؤاخِذْني بما يقولونَ، واغفِرْ لي ما لا يعلمونَ، واجعَلْني خيرًا ممَّا يظُنّونَ",
      "count": 1,
      "hokm": "أثر",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اعمَلوا، فإنَّكم على عملٍ صالحٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أخذنا فألَكَ من فيكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ، اللهُ أكبرُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "بئسَ ما قلتَ! واللهِ ما عَلِمنا عليهِ إلا خيرًا",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "سُبحانَ ربِّي",
      "count": 1,
      "hokm": "قرآني",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "مرحبًا بِوَصيَّةِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم",
      "count": 1,
      "hokm": "أثر",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "لا، ومُقَلِّبِ القلوبِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أعوذُ باللهِ من الشيطانِ الرجيمِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أعوذُ باللهِ السميعِ العليمِ من الشيطانِ الرجيمِ، من همزِهِ ونفخِهِ ونفثِهِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ الذي بِنِعمَتِهِ تَتِمُّ الصالحاتُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ على كلِّ حالٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "QuranText[(39:46:46)]",
      "count": 1,
      "hokm": "قرآني",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ إنِّي أسألُكَ العافيةَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أعوذُ باللهِ من الفِتَنِ ما ظهَرَ منها وما بطَنَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "رَضينا باللهِ ربًّا، وبالإسلامِ دينًا، وبمحمدٍ صلَّى اللهُ عليهِ وسلَّم رسولًا، نعوذُ باللهِ من سوءِ الفِتَنِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ سَلِّمْني، وسَلِّمْ مِنِّي",
      "count": 1,
      "hokm": "ضعيف",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ إنّا نعوذُ بِكَ أنْ نَرجِعَ على أعقابِنا، أو نُفتَنَ",
      "count": 1,
      "hokm": "أثر",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "جزاكَ اللهُ خيرًا",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ فَقِّهْهُ في الدينِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ أكثِرْ مالَهُ ووَلَدَهُ، وبارِكْ لهُ فيما أعطيتَهُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "الحمدُ للهِ الذي عافاني ممَّا ابتلَاكَ بهِ، وفضَّلَني على كثيرٍ ممَّن خَلَقَهُ تفضيلًا",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "بارَكَ اللهُ لكَ في أهلِكَ ومالِكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أوفيْتَني، أوفى اللهُ بِكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ إنِّي أسألُكَ من خيرِها، وخيرِ ما جَبَلتَها عليهِ، وأعوذُ بِكَ من شرِّها وشرِّ ما جَبَلتَها عليهِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ بارِكْ لنا في ثَمَرِنا، وبارِكْ لنا في مَدينَتِنا، وبارِكْ لنا في صاعِنا، وبارِكْ لنا في مُدِّنا، بركةً معَ بركةٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "QuranText[(18:39:39)]",
      "count": 1,
      "hokm": "قرآني",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ بارِكْ فيهِ، ولا تَضُرَّهُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أُعيذُكَ بكلماتِ اللهِ التَّامَّةِ، من كلِّ شيطانٍ وهامَّةٍ، ومن كلِّ عينٍ لامَّةٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ إنِّي أسألُكَ من فضلِكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "أعوذُ باللهِ السميعِ العليمِ من الشيطانِ الرجيمِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "السلامُ علينا وعلى عبادِ اللهِ الصالحين",
      "count": 1,
      "hokm": "أثر",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ إنِّي أعوذُ بِكَ أنْ أُشرِكَ بِكَ وأنا أعلمُ، وأستغفرُكَ لما لا أعلمُ",
      "count": 3,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    },
    {
      "body": "لَيتَني أُوتيتُ مِثلَ ما أُوتيَ فلانٌ، فَعَمِلتُ مِثلَ ما يَعمَلُ",
      "count": 1,
      "hokm": "صحيح",
      "source": "الأذكار المتفرقة من السنة. (ص156–163)",
      "fadl": ""
    }
  ]
}
