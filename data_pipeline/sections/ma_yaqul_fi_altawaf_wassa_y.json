    {
      "body": "أبدأُ بما بدأَ اللهُ به",
      "count": 1,
      "hokm": "صحيح",
      "source": "الطواف والسعي. (ص117–121)",
      "fadl": ""
    },
    {
      "body": "اللهُ أكبرُ، اللهُ أكبرُ، اللهُ أكبرُ، لا إلهَ إلا اللهُ وحدَهُ، لا شريكَ لهُ، لهُ الملكُ، ولهُ الحمدُ، يُحيي ويُميتُ، وهو على كلِّ شيءٍ قديرٌ، لا إلهَ إلا اللهُ وحدَهُ، لا شريكَ لهُ، أنجزَ وعدَهُ، ونصرَ عبدَهُ، وهزمَ الأحزابَ وحدَهُ",
      "count": 3,
      "hokm": "صحيح",
      "source": "الطواف والسعي. (ص117–121)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ إنَّكَ قلتَ: ادعوني أستجبْ لكم، وإنَّكَ لا تُخلِفُ الميعادَ، وإنِّي أسألُكَ كما هديتَني للإسلامِ أن لا تنزعَهُ منِّي حتى تتوفَّاني وأنا مسلمٌ",
      "count": 1,
      "hokm": "أثر",
      "source": "الطواف والسعي. (ص117–121)",
      "fadl": ""
    },
    {
      "body": "ربِّ اغفرْ وارحمْ، إنَّكَ أنتَ الأعزُّ الأكرمُ",
      "count": 1,
      "hokm": "أثر",
      "source": "الطواف والسعي. (ص117–121)",
