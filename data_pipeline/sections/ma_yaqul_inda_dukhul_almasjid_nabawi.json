  "items": [
    {
      "body": "أعوذُ باللهِ العظيمِ، وبوجهِهِ الكريمِ، وسلطانِهِ القديمِ، من الشيطانِ الرجيمِ",
      "count": 1,
      "hokm": "صحيح",
      "source": "دخول المسجد النبوي. (ص128–129)",
      "fadl": ""
    },
    {
      "body": "باسمِ اللهِ، اللهمَّ صلِّ على محمدٍ وعلى أزواجِ محمدٍ",
      "count": 1,
      "hokm": "صحيح",
      "source": "دخول المسجد النبوي. (ص128–129)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ صلِّ على محمدٍ وآلِهِ وسلِّمْ",
      "count": 1,
      "hokm": "صحيح",
      "source": "البديل عند دخول المسجد النبوي. (ص128)",
      "fadl": ""
    },
    {
      "body": "اللهمَّ افتحْ لي أبوابَ رحمتِكَ",
      "count": 1,
      "hokm": "صحيح",
      "source": "دخول المسجد النبوي. (ص128–129)",
